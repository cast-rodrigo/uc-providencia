---
import '../styles/global.css';
import sitio from '../data/sitio.json';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = sitio.bajada } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${sitio.nombre}` : `${sitio.nombre} · ${sitio.lema}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const robots = sitio.indexarEnGoogle ? 'index, follow' : 'noindex, nofollow';
// Imagen para compartir (WhatsApp, Facebook…): public/og-uc-providencia.jpg (1200×630).
const imagenOg = new URL('/og-uc-providencia.jpg', Astro.site);
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#20609f" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#001e50" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={sitio.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${sitio.nombre}: ${sitio.lema}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      // Aplica el modo oscuro antes de pintar, para evitar parpadeos.
      (function () {
        var guardado = null;
        try { guardado = localStorage.getItem('tema'); } catch (e) {}
        var oscuro = guardado ? guardado === 'oscuro' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', oscuro);
        document.documentElement.classList.add('js');
      })();
    </script>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-uc-azul focus:px-4 focus:py-2 focus:text-white"
      >Saltar al contenido</a
    >
    <slot />

    <script>
      // Las franjas entran cuando aparecen en pantalla.
      // Se revisa al hacer scroll; las que ya quedaron arriba (al saltar con el menú) también se muestran.
      let pendientes = [...document.querySelectorAll('.franja-scroll')];
      let esperando = false;
      const revisar = () => {
        esperando = false;
        const limite = innerHeight * 0.92;
        pendientes = pendientes.filter((f) => {
          if (f.getBoundingClientRect().top > limite) return true;
          f.classList.add('visible');
          return false;
        });
        if (!pendientes.length) removeEventListener('scroll', alMover);
      };
      const alMover = () => {
        if (esperando) return;
        esperando = true;
        requestAnimationFrame(revisar);
      };
      addEventListener('scroll', alMover, { passive: true });
      revisar();
    </script>
  </body>
</html>
