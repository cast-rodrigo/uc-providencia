---
import Layout from '../layouts/Layout.astro';
import Navegacion from '../components/Navegacion.astro';
import Hero from '../components/Hero.astro';
import ProximoPartido from '../components/ProximoPartido.astro';
import Plantel from '../components/Plantel.astro';
import CuerpoTecnico from '../components/CuerpoTecnico.astro';
import Instagram from '../components/Instagram.astro';
import GaleriaAdelanto from '../components/GaleriaAdelanto.astro';
import SerCruzado from '../components/SerCruzado.astro';
import Entrenamientos from '../components/Entrenamientos.astro';
import PiePagina from '../components/PiePagina.astro';
import SeparadorFranja from '../components/SeparadorFranja.astro';
---

<Layout>
  <Navegacion />
  <main id="contenido">
    <Hero />
    <SeparadorFranja />
    <ProximoPartido />
    <Plantel />
    <CuerpoTecnico />
    <Instagram />
    <GaleriaAdelanto />
    <SerCruzado />
    <Entrenamientos />
  </main>
  <PiePagina />
</Layout>
