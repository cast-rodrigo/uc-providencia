---
import Escudo from './Escudo.astro';
import sitio from '../data/sitio.json';

const anio = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-uc-noche text-white">
  <div aria-hidden="true" class="h-3 bg-uc-azul"></div>
  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div class="flex items-center gap-4">
      <Escudo alt="Escudo de la Universidad Católica" tamano={72} />
      <div>
        <p class="font-display text-3xl font-extrabold tracking-wide uppercase">{sitio.nombre}</p>
        <p class="font-display text-lg text-uc-cielo italic">{sitio.lema}</p>
      </div>
    </div>

    <ul class="flex flex-wrap gap-3">
      <li>
        <a
          href={sitio.instagramUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-2 rounded-full bg-white/10 px-4 font-medium transition hover:bg-white hover:text-uc-noche"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
          {sitio.instagramUsuario}
        </a>
      </li>
      <li>
        <a
          href="https://cruzados.cl"
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center rounded-full bg-white/10 px-4 font-medium transition hover:bg-white hover:text-uc-noche"
        >
          cruzados.cl
        </a>
      </li>
    </ul>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-white/80 sm:flex-row sm:justify-between sm:px-6">
      <p>Hecho con amor por un papá cruzado ⚪🔵</p>
      <p>© {anio} {sitio.nombre} · Sin publicidad ni seguimiento</p>
    </div>
  </div>
</footer>
