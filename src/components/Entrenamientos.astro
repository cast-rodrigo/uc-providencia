---
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import datos from '../data/entrenamientos.json';

const { lat, lon, nombre, direccion } = datos.ubicacion;
const d = 0.006;
const mapa = `https://www.openstreetmap.org/export/embed.html?bbox=${lon - d},${lat - d / 1.6},${lon + d},${lat + d / 1.6}&layer=mapnik&marker=${lat},${lon}`;
const comoLlegar = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
const googleMaps = `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`;
---

<section id="entrenamientos" aria-labelledby="titulo-entrenamientos" class="py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <EncabezadoSeccion
      id="titulo-entrenamientos"
      antetitulo="Nos vemos en la cancha"
      titulo="Entrenamientos y ubicación"
    />

    <div class="mt-10 grid gap-6 lg:grid-cols-[1fr_1.2fr]">
      <div class="flex flex-col gap-4">
        <ul class="grid gap-3">
          {
            datos.horarios.map((h) => (
              <li class="tarjeta flex items-center gap-4 p-4 hover:-translate-y-0.5">
                <span class="grid h-14 w-20 shrink-0 place-items-center rounded-xl bg-uc-azul font-display text-lg font-extrabold tracking-wide text-white uppercase">
                  {h.dia.slice(0, 3)}
                </span>
                <div>
                  <p class="font-semibold text-uc-noche dark:text-white">
                    {h.dia} · {h.hora}
                  </p>
                  {h.detalle && <p class="text-sm text-gris-600 dark:text-gris-200">{h.detalle}</p>}
                </div>
              </li>
            ))
          }
        </ul>
        {
          datos.nota && (
            <p class="rounded-uc border-l-4 border-uc-azul bg-gris-50 p-4 text-gris-800 dark:bg-uc-noche-2 dark:text-gris-100">
              {datos.nota}
            </p>
          )
        }
        <div class="tarjeta p-5">
          <p class="font-semibold text-uc-noche dark:text-white">{nombre}</p>
          <p class="text-gris-600 dark:text-gris-200">{direccion}</p>
          <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
            <a href={googleMaps} target="_blank" rel="noopener" class="text-uc-azul underline-offset-4 hover:underline dark:text-uc-cielo">
              Abrir en Google Maps
            </a>
            <a href={comoLlegar} target="_blank" rel="noopener" class="text-uc-azul underline-offset-4 hover:underline dark:text-uc-cielo">
              Ver en OpenStreetMap
            </a>
          </div>
        </div>
      </div>

      <div class="tarjeta min-h-80 overflow-hidden">
        <iframe
          src={mapa}
          title={`Mapa: ${nombre}`}
          loading="lazy"
          referrerpolicy="no-referrer"
          class="size-full min-h-80 border-0 dark:brightness-90"></iframe>
      </div>
    </div>
  </div>
</section>
