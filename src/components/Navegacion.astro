---
import Escudo from './Escudo.astro';
import sitio from '../data/sitio.json';

const enlaces = [
  { href: '/#partido', texto: 'Partidos' },
  { href: '/#equipo', texto: 'Equipo' },
  { href: '/#cuerpo-tecnico', texto: 'Cuerpo técnico' },
  { href: '/#instagram', texto: 'Instagram' },
  { href: '/galeria', texto: 'Galería' },
  { href: '/#ser-cruzado', texto: 'Ser cruzado' },
  { href: '/#entrenamientos', texto: 'Entrenamientos' },
];
---

<header
  class="sticky top-0 z-40 border-b border-gris-100/80 bg-white/85 backdrop-blur-md dark:border-white/10 dark:bg-uc-noche/85"
>
  <nav aria-label="Principal" class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2.5 rounded-lg">
      <Escudo alt="" tamano={36} />
      <span class="font-display text-xl font-extrabold tracking-wide text-uc-azul uppercase dark:text-white">
        {sitio.nombre}
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        enlaces.map((e) => (
          <li>
            <a
              href={e.href}
              class="relative rounded-lg px-3 py-2 text-sm font-medium text-gris-800 transition-colors after:absolute after:inset-x-3 after:bottom-1 after:h-0.5 after:origin-left after:scale-x-0 after:bg-uc-rojo after:transition-transform hover:text-uc-azul hover:after:scale-x-100 dark:text-gris-100 dark:hover:text-uc-cielo"
            >
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-1">
      <button
        type="button"
        data-tema
        class="grid size-11 place-items-center rounded-full text-gris-600 transition hover:bg-gris-100 hover:text-uc-azul dark:text-gris-200 dark:hover:bg-white/10 dark:hover:text-white"
      >
        <span class="sr-only">Cambiar entre modo claro y oscuro</span>
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path></svg>
      </button>

      <button
        type="button"
        data-menu-boton
        aria-expanded="false"
        aria-controls="menu-movil"
        class="grid size-11 place-items-center rounded-full text-uc-azul transition hover:bg-gris-100 lg:hidden dark:text-white dark:hover:bg-white/10"
      >
        <span class="sr-only">Abrir menú</span>
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </nav>

  <div id="menu-movil" hidden class="border-t border-gris-100 bg-white lg:hidden dark:border-white/10 dark:bg-uc-noche">
    <ul class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      {
        enlaces.map((e) => (
          <li>
            <a
              href={e.href}
              data-menu-enlace
              class="flex min-h-12 items-center border-l-4 border-transparent px-3 font-display text-xl font-bold tracking-wide text-uc-noche uppercase hover:border-uc-azul hover:bg-gris-50 dark:text-white dark:hover:bg-white/5"
            >
              {e.texto}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const html = document.documentElement;

  document.querySelector('[data-tema]')?.addEventListener('click', () => {
    const oscuro = html.classList.toggle('dark');
    try {
      localStorage.setItem('tema', oscuro ? 'oscuro' : 'claro');
    } catch {}
  });

  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.getElementById('menu-movil');
  const cerrar = () => {
    if (!boton || !menu) return;
    menu.hidden = true;
    boton.setAttribute('aria-expanded', 'false');
  };
  boton?.addEventListener('click', () => {
    if (!menu) return;
    const abrir = menu.hidden;
    menu.hidden = !abrir;
    boton.setAttribute('aria-expanded', String(abrir));
  });
  document.querySelectorAll('[data-menu-enlace]').forEach((a) => a.addEventListener('click', cerrar));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      cerrar();
      boton?.focus();
    }
  });
</script>
