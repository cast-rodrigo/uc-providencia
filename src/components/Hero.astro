---
import Escudo from './Escudo.astro';
import sitio from '../data/sitio.json';
---

<section
  id="inicio"
  aria-labelledby="titulo-hero"
  class="relative isolate overflow-hidden bg-white pb-16 dark:bg-uc-noche sm:pb-24"
>
  <!-- Fondo: un brillo suave, como la tela blanca de la camiseta bajo los focos. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_right,var(--color-gris-50),transparent_60%)] dark:bg-[radial-gradient(ellipse_at_top_right,var(--color-uc-noche-2),transparent_60%)]"
  >
  </div>

  <div class="aparece mx-auto max-w-6xl px-4 pt-10 sm:px-6 sm:pt-16">
    <p class="inline-flex items-center gap-2 rounded-full border border-gris-200 px-3 py-1 text-xs font-semibold tracking-widest text-gris-600 uppercase dark:border-white/15 dark:text-gris-200">
      <span class="size-2 rounded-full bg-uc-rojo" aria-hidden="true"></span>
      {sitio.temporada} · Fútbol infantil
    </p>
  </div>

  <h1 id="titulo-hero" class="mt-4 font-display font-extrabold uppercase sm:mt-6">
    <span
      class="aparece mx-auto block max-w-6xl px-4 text-[clamp(5.5rem,26vw,14rem)] leading-[0.78] tracking-tight text-uc-azul sm:px-6 dark:text-white"
    >
      UC
    </span>

    <!-- La franja: cruza la pantalla a la altura del pecho. -->
    <span class="relative mt-2 block sm:mt-3">
      <span aria-hidden="true" class="franja-entra absolute inset-0 -z-10 bg-uc-azul shadow-suave"></span>
      <span class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
        <span class="py-2 text-[clamp(2.6rem,12.5vw,8.5rem)] leading-[0.95] tracking-tight text-white sm:py-4">
          Providencia
        </span>
        <!-- El escudo va sobre la franja, al lado del corazón, como en la camiseta. -->
        <span
          class="aparece -my-6 block size-20 shrink-0 rounded-3xl bg-white p-1.5 shadow-suave ring-4 ring-white sm:-my-10 sm:size-36 sm:p-2.5 dark:bg-uc-noche dark:ring-uc-noche"
          style="animation-delay: 0.45s"
        >
          <Escudo alt="" fluido />
        </span>
      </span>
    </span>
  </h1>

  <div class="aparece mx-auto mt-8 max-w-6xl px-4 sm:mt-12 sm:px-6" style="animation-delay: 0.25s">
    <p class="font-display text-3xl font-extrabold tracking-tight text-uc-noche italic sm:text-5xl dark:text-uc-cielo">
      {sitio.lema}
    </p>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-gris-600 sm:text-lg dark:text-gris-200">
      {sitio.bajada}
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="#partido"
        class="btn bg-uc-azul text-white shadow-suave hover:bg-uc-azul-hondo dark:bg-white dark:text-uc-noche dark:hover:bg-uc-cielo"
      >
        Próximo partido
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
      <a
        href={sitio.instagramUrl}
        target="_blank"
        rel="noopener"
        class="btn border-2 border-uc-azul text-uc-azul hover:bg-uc-azul hover:text-white dark:border-white/70 dark:text-white dark:hover:bg-white dark:hover:text-uc-noche"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
        Síguenos en Instagram
        <span class="sr-only">(se abre en una pestaña nueva)</span>
      </a>
    </div>
  </div>
</section>
