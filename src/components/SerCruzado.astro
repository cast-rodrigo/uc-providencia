---
import EncabezadoSeccion from './EncabezadoSeccion.astro';
import { Content } from '../content/ser-cruzado.md';
---

<section id="ser-cruzado" aria-labelledby="titulo-cruzado" class="relative isolate overflow-hidden bg-uc-noche py-20 text-white sm:py-28">
  <!-- La franja gigante de fondo, cruzando la sección. -->
  <div aria-hidden="true" class="absolute inset-x-0 top-[58%] -z-10 h-28 sm:h-40">
    <div class="franja-scroll h-full bg-uc-azul"></div>
  </div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-6 bottom-6 -z-10 font-display text-[11rem] leading-none font-extrabold text-white/5 sm:text-[18rem]">
    1930
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
    <EncabezadoSeccion id="titulo-cruzado" antetitulo="Desde 1930" titulo="Ser cruzado" claro />

    <div>
      <div class="space-y-4 text-lg leading-relaxed text-white/90 [&_strong]:font-semibold [&_strong]:text-white">
        <Content />
      </div>
      <a
        href="https://cruzados.cl/himno"
        target="_blank"
        rel="noopener"
        class="btn mt-8 bg-white text-uc-noche hover:bg-uc-cielo"
      >
        Escucha el himno cruzado
        <span class="sr-only">(se abre cruzados.cl en una pestaña nueva)</span>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </a>
    </div>
  </div>
</section>
